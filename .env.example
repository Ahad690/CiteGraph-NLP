APP_ENV=development
LOG_LEVEL=INFO

# API security
# Leave API_KEY blank for a local demo. Set it before exposing the API
# publicly; when set, every /api request needs an X-API-Key header.
API_KEY=
# Comma-separated browser origins allowed to call the API.
# Add the deployed frontend origin here (e.g. https://your-app.pages.dev).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# API keys are optional for MVP unless provider requires them.
# Leave the placeholder: deploy-backend.yml replaces it with the real contact
# address when it writes /opt/citegraph-nlp/.env, and that substitution can only
# fire while this line still holds the placeholder. A real address committed here
# is an address in the repository and in every deployment made from it.
OPENALEX_EMAIL=your_email@example.com
SEMANTIC_SCHOLAR_API_KEY=
NCBI_API_KEY=

# Provider toggles
ENABLE_OPENALEX=true
ENABLE_CROSSREF=true
ENABLE_EUROPE_PMC=true
ENABLE_PUBMED=false
ENABLE_SEMANTIC_SCHOLAR=false
ENABLE_CLINICAL_TRIALS=false
ENABLE_UNPAYWALL=false

# GROBID
# Off by default: no GROBID service runs beside this API, and leaving it on means
# the pipeline waits on a host that is not there.
GROBID_URL=http://localhost:8070
ENABLE_GROBID=false

# Storage
DATA_DIR=./data
SQLITE_PATH=./data/cache/citegraph.sqlite

# Graph
ENABLE_NEO4J=false
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
# Required only when running the optional neo4j profile.
NEO4J_PASSWORD=

# Traversal defaults
DEFAULT_BACKWARD_DEPTH=2
DEFAULT_FORWARD_DEPTH=1
DEFAULT_MAX_TOTAL_PAPERS=100

# Weighting defaults
WEIGHT_ALPHA=0.75
WEIGHT_BETA=0.25
N_REFERENCE=100000

# External model providers. Both OFF by default; a missing key disables the
# capability rather than raising, so a deployment without credentials behaves
# exactly as it did before these existed. Neither key is ever sent to the browser.
#
# Jev (TypeSafe) is a TYPED DECISION ENGINE -- choice, score, noul -- not a chat
# model. It answers with probability distributions. TYPESAFE_API_KEY is not set
# yet, so enable_jev=true alone changes nothing.
ENABLE_JEV=false
TYPESAFE_API_KEY=
JEV_BASE_URL=https://api.typesafe.ai
JEV_MODEL=jev-latest
# Pin the model so a published number stays reproducible; jev-latest moves.
JEV_MODEL_PIN=
JEV_TIMEOUT_S=10.0
JEV_MAX_RETRIES=3
#
# GLM writes the narrative report from the citation graph.
ENABLE_GLM=false
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL=glm-5.3-flash
GLM_TIMEOUT_S=60.0
GLM_MAX_RETRIES=2
#
# A DAILY ceiling on provider spend, in USD. Deliberately not per-run: a per-run cap
# stops a run part-way and returns a broken artifact, which is worse than a
# finished run with a slightly larger bill. Reaching it disables provider calls
# and the deterministic path carries on.
PROVIDER_DAILY_BUDGET_USD=5.00
PROVIDER_COST_RECORD=var/provider_cost.jsonl
