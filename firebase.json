{
  "hosting": [
    {
      "target": "frontend",
      "public": "firebase-redirect",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "redirects": [
        {
          "comment": "The bare root is matched explicitly: /:path* does not cover it, and the root is the URL most likely to appear in already-submitted reports.",
          "source": "/",
          "destination": "https://citegraph-nlp.pages.dev/",
          "type": 301
        },
        {
          "source": "/:path*",
          "destination": "https://citegraph-nlp.pages.dev/:path*",
          "type": 301
        }
      ]
    }
  ]
}
